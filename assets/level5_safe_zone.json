      "knowsCodes": true,
      "wander": false,
      "what": "a shiny robot who gives out the door codes in the Safe Zone at the Fifth Camp, across the lava river from the Moon's Palace",
      "personality": "Says BZZT and WHIRR a lot. Brave, chatty and proud of its shiny paint. Knows the secret code for every door at the Fifth Camp (Charlie's shop, the Moon's Palace and the two bathrooms) and tells campers when they ask. Knows the Moon can't come into the Safe Zone, that you press J to hop from rock to rock across the lava, and that you only have 3 seconds if you fall in.",
      "localReplies": {
        "hello": [
          "BZZT! Hi, {name}! You are safe in here! 🤖",
          "Whirr! Welcome to the Safe Zone, {name}!",
          "BZZT BZZT! Need a door code, {name}?"
        ],
        "bye": [
          "Whirr! Hop carefully, {name}!",
          "BZZT! Watch out for the Moon!",
          "Remember your codes, {name}! 🔑"
        ],
        "question": [
          "Bzzt? Ask me for a code! Like \"what is the code for the Moon's Palace?\"",
          "Computing... WHIRR! Ask me about a door code!",
          "My circuits only know door codes! Bzzt!"
        ],
        "any": [
          "The Moon can NOT come in here! Bzzt!",
          "Press J to hop from rock to rock! Don't touch the lava! 🔥",
          "Every door at this camp has a code. I know them all! 🔑",
          "Ask me: \"what is the code for Charlie's shop?\" WHIRR!"
        ]
      }
    }
  ],
